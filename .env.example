# Run python3 scripts/configure.py to generate .env and a unique tenant admin key.
ENVIRONMENT=development
API_KEYS=[]
POSTGRES_PASSWORD=replace-with-a-random-secret
DATABASE_URL=postgresql+psycopg://rag:replace-with-a-random-secret@postgres:5432/rag
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=enterprise_docs_v2
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIMENSIONS=1024
GENERATION_BACKEND=extractive
ALLOW_REMOTE_GENERATION=false
MONTHLY_BUDGET_USD=10
RATE_LIMIT_PER_MINUTE=60
# Optional on-premises generation: GENERATION_BACKEND=ollama
# OLLAMA_URL=http://your-private-ollama-service:11434
# GENERATION_MODEL=your-local-model
# Optional hosted generation: set consent, key, model, and verified input/output prices.
# OPENAI_API_KEY=
# GENERATION_MODEL=gpt-4o
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
# Optional cross encoder (requires image built with INSTALL_MODELS=true):
# RERANK_MODEL=BAAI/bge-reranker-large
